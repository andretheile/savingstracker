# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://savingstracker:changeme@localhost:5432/savingstracker
DB_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Telegram (legacy fallback; each household stores its own bot token in Settings) ──
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Optional: only these Telegram user IDs may use DMs (comma-separated). Empty = any linked account.
TELEGRAM_ALLOWED_USER_IDS=
# Household group/supergroup chat IDs (comma-separated, usually negative). Empty = groups denied.
# The bot replies with the chat id when someone @mentions it in an unknown group.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Web auth (Google) ─────────────────────────────────────
# Create an OAuth Web client. Redirect: http://localhost:8000/auth/callback
# and later https://your-host/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cookie signing key (not the Fernet ENCRYPTION_KEY). Generate a long random string.
AUTH_SECRET_KEY=
# Optional signup gate. Empty = any Google account creates its own household.
# Household invites can still add emails that are not on this list.
ALLOWED_EMAILS=
# Google emails that can list and delete other households from Settings.
ADMIN_EMAILS=
# Public origin used for the OAuth callback behind Traefik, e.g. https://savings.example.com
PUBLIC_BASE_URL=

# ── LLM (OpenRouter) ──────────────────────────────────────
# https://openrouter.ai/keys — used for Telegram chat + tool calls
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=x-ai/grok-4.6

# ── Bank Connection (FinTS) ───────────────────────────────
# Register at https://www.fints.org/de/hersteller/produktregistrierung
# DKB rejects unknown/generic product IDs — use your own registered ID.
FINTS_PRODUCT_ID=your-fints-product-id

# ── Security ──────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key

# ── App Settings ──────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false
